# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ==============================================
# JWT Configuration
# ==============================================
# Generate a secure secret key (256-bit recommended)
# You can generate one using: openssl rand -base64 32
JWT_SECRET=67bd2f0b951a27bd46a08fa83100d90d38c84d0f7b65fc1c4d7b3f9fa9728700

# Token expiry times (in milliseconds)
# Access token: 15 minutes (900000ms)
# Refresh token: 7 days (604800000ms)

# ==============================================
# Email Configuration (Gmail SMTP)
# ==============================================
# Your Gmail address
MAIL_USERNAME=testtclm101gmail@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to get App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication if not enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Generate an App Password for "Mail"
# 5. Use that 16-character password here
MAIL_PASSWORD=0386526003trung

# ==============================================
# OAuth2 - Google Configuration
# ==============================================
# Get Google OAuth2 credentials:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID
# 3. Set Authorized redirect URIs to:
#    - http://localhost:8080/login/oauth2/code/google (development)
#    - https://yourdomain.com/login/oauth2/code/google (production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================
# OAuth2 - Facebook Configuration
# ==============================================
# Get Facebook OAuth2 credentials:
# 1. Go to https://developers.facebook.com/apps/
# 2. Create a new app or select existing
# 3. Go to Settings > Basic
# 4. Get App ID and App Secret
# 5. Add OAuth Redirect URIs in Facebook Login settings:
#    - http://localhost:8080/login/oauth2/code/facebook (development)
#    - https://yourdomain.com/login/oauth2/code/facebook (production)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ==============================================
# Application Configuration
# ==============================================
# Frontend URL for CORS and OAuth2 redirects
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# ==============================================
# Database Configuration (if using environment variables)
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fnb_recommender
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# ==============================================
# IMPORTANT SECURITY NOTES
# ==============================================
# 1. NEVER commit this file with real values to version control
# 2. Add .env to .gitignore
# 3. Change JWT_SECRET in production to a strong random value
# 4. Use different credentials for development and production
# 5. Rotate secrets regularly
# 6. Use environment-specific configuration files
# 7. Consider using a secrets management service (AWS Secrets Manager, HashiCorp Vault, etc.)
